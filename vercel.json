{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.stack-md.online"
        }
      ],
      "destination": "https://stack-md.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/profile",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/__spa-fallback.html"
    }
  ]
}
